# Copy this file to .env.local and fill in the two values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored and must never be committed. This example file only
# ever contains placeholders, which is why it is the one .env* file that is
# tracked in the repository.
#
# Where the values come from:
#   Project Settings -> API  in the Supabase dashboard.
#
#   NEXT_PUBLIC_SUPABASE_URL        the project URL, https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   the publishable / anon key
#
# The anon key is designed to be public: every row access goes through Row Level
# Security, so exposing it grants nothing on its own. The Service Role key and
# any other secret must NOT go in this file and must never reach the client
# bundle.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
